# Secret server key, restricted to Places API (New) and Geocoding API.
GOOGLE_PLACES_API_KEY=
# Optional alias for the private server key (never sent to the frontend).
GOOGLE_MAPS_API_KEY=
# Public browser key, restricted to Maps JavaScript API and exact HTTP referrers.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
DAILY_ANALYSIS_LIMIT=5
# Generate a random value of 32+ characters. Never commit real secrets.
RATE_LIMIT_SECRET=
# Conventional Next.js only: set only behind a proxy that overwrites the header.
TRUSTED_IP_HEADER=
